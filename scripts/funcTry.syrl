=>[
	$ b1 = # ()
	{
		$ add = # (a,b) [a + b];
		$ a = 10;
		$ b = 233;
		Write a + " + " + b + " = ";
		Write :line # add (a,b);
	},
	$ b2 = # ()
	{
		$ fun1 = # (n) [{
		  Write :line n;
		  ? [n <= 0] (<= "end!",<= # fun1 (n-1));
		}];
		Write :line # fun1 (10);
	},
	$ b3 = # ()
	{
		$ fun2 = # (n) [{
		  ? [n > 1] (# fun2 (n-1),0);
		  Write :line n;
		  <= n;
		}];
		# fun2 (10);
	},
	$ b4 = # ()
	{
		$ fun3 = # (n) {
		  Write :line n;
		  ? [n <= 0] (<= "e",0);
		  # fun3 (n - 1);
		};
		Write [# fun3 (10)];
	},
	$ b22 = # ()
	{
		$ fun = # (n) [{
		  Write :line n;
		  ? [n <= 0] (<= "e",0);
		  # fun (n - 1);
		}];
		Write :line # fun (0);
	},
	# b3 (),
	0
]