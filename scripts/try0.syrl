// 本篇语法已过时，不能执行

=>[
	ret: -I32 = 0,				//:(主变格符)在后面表示主语，紧跟其后的-后标为修饰语
								//可有多个，可用于表示类型或归属的类等
	@{
		?[1 == 1]{
			(ret = 1,<);
			<= 0;
		}; //()无作用域，用','分隔
		// <= 表示强制返回当前表达式[]
		// < 表示退出当前最近的{}作用域，例如@{},{}
		// {}有作用域，用';'分隔
		i = ?0(1,true,false,4); 		//i = 1
		i1 = ?0(1,true,0#false,4); 		//i1 = false
		j = "s";
		?j(#"s" i = 10,"s2"# i = 2); //10
		//?表示控制流，如果不加#则是按index，加#则是按#前的值
		// 优先匹配#
		// true和false当1和0
		Console: -Super Write "Hello World!";
	},
   	ret							//[]按顺序执行，也按','分隔，其值是最后一项
]
