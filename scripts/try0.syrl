// 语句的孤立表示：
// 语句本身能被看作值传递，但是在一些情况下，尤其是在表达式中，我们希望传递而不是执行它
// 为了避免歧义，我们用``包裹语句，使其被当作值看待
// a = (`Console:`,`-Super`);			// ``也能包裹词，即(大部分是不可执行的)不完整语句
// b = [`Write "1"`];  				// ``使得词被看作值（字面语句），所以[]能返回他们
// c = ['a + b];					// '表示解除引用，这里表示对列表内部的词直接链接，产生了一个语句或词
// // 这里表达式返回的就是一个语句，可以看出
// // +部分`词`的加法 c = `Console: -Super Write "1"`
// d = [b + a];					// +列表加法，d = (`Write "1"`,`Console:`,`-Super`)
// [c == 'd];						// true，语序不影响语句的相等（进行了隐式的解引用）
// 'd;	 							// '表示将语句暴露在外，变成可执行的形式
// '[a + b];

// f = 0?(Console: -Super Write "1");
// f1 = 0?{Console: -Super Write "1";};
// 这些是语句本身作为值传递的例子（词本身不可以，必须用``），因为语句不加括号极容易产生歧义，所以我们通常要使用容器符号（如(),{},``）来包裹他们，而使用[]会导致语句直接执行
// f;f1; // 如果此处可执行（例如在表达式或被执行的语句块中），将直接执行他们