Write "Hello 'SyLow RealLike' world!";
$ var1 = 100;
Write var1;
$ var2 = var1 * 233 * 0.0001;
$ msg = "Hello World";
Write var2 + var1;
Write msg;
$ stmt1 = `Write "Gen Programming!";`;
'stmt1;
$ write = `Write `;
$ msg2 = `msg `;
$ semicolon = `;`;
// Write [write + msg2 + semicolon];
'[write + msg2 + semicolon];
msg = "Hello Wch!";
'[write + msg2 + semicolon];
$ loop = 100;
@{
	Write "Hello "+loop;
	loop = loop - 1;
	? [loop < 0] (<;);
}