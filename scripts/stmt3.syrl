/* SyLow RealLike Demo!
*/
=>[
	$ a = 10,
	{
		$ b = a;
		$ function = "Write :line # [9 - b] \"HelloWorld\"";
		@{
			?[b <= 0](<= `"[Write :line \"Hello\",Write :line 233]",null);
			b = b - 1;
			`function;
			/* Write :line "!!!"
			**/ Write :line "^--"; // ok
		};
	},
	Write "Hello" // :noun
]